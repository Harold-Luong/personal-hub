rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
// users/{uid}: private profile and initialization timestamps.
// users/{uid}/modules/expenses: expense module state.
// users/{uid}/modules/expenses/settings/main: UI and finance preferences.
// users/{uid}/modules/expenses/wallets/{walletId}: wallet projections.
// users/{uid}/modules/expenses/categories/{categoryId}: income/expense categories.
// users/{uid}/modules/expenses/transactions/{transactionId}: financial ledger entries.
// users/{uid}/modules/expenses/budgets/{budgetId}: monthly category budgets.
// users/{uid}/modules/expenses/monthlyStats/{monthKey}: monthly projections.
// users/{uid}/modules/quotes/favorites/{quoteId}: quoteId string and createdAt timestamp.
// Every path is private to the authenticated owner identified by {uid}.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == resource.data.uid;
    }

    // =========================
    // Common
    // =========================

    function isValidCurrency(currency) {
      return currency in ['VND', 'USD'];
    }

    function isValidString(value) {
      return value is string && value.size() > 0;
    }

    function isOptionalString(value) {
      return value == null || value is string;
    }

    // =========================
    // User profile
    // users/{uid}
    // =========================

    function allowedUserProfileKeys() {
      return [
        'displayName',
        'email',
        'photoURL',
        'createdAt',
        'initializedAt',
        'updatedAt',
      ];
    }

    function isValidUserProfileCreate(data) {
      return uidUnchanged()
        && data.keys().hasOnly(allowedUserProfileKeys())
        && data.keys().hasAll([
          'displayName',
          'email',
          'photoURL',
          'createdAt',
          'initializedAt',
          'updatedAt',
        ])
        && isOptionalString(data.displayName)
        && isOptionalString(data.email)
        && isOptionalString(data.photoURL)
        && data.createdAt == request.time
        && data.initializedAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidUserProfileUpdate() {
      return uidNotModified()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'displayName',
            'updatedAt',
          ])
        && request.resource.data.keys().hasOnly(allowedUserProfileKeys())
        && isValidString(request.resource.data.displayName)
        && request.resource.data.email == resource.data.email
        && request.resource.data.photoURL == resource.data.photoURL
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.initializedAt == resource.data.initializedAt
        && request.resource.data.updatedAt == request.time;
    }

    // =========================
    // Expense module root
    // users/{uid}/modules/expenses
    // =========================

    function allowedExpenseModuleKeys() {
      return [
        'enabled',
        'createdAt',
        'updatedAt',
      ];
    }

    function isValidExpenseModuleCreate(data) {
      return data.keys().hasOnly(allowedExpenseModuleKeys())
        && data.keys().hasAll([
          'enabled',
          'createdAt',
          'updatedAt',
        ])
        && data.enabled is bool
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidExpenseModuleUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'enabled',
            'updatedAt',
          ])
        && request.resource.data.enabled is bool
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    // =========================
    // Expense settings
    // users/{uid}/modules/expenses/settings/main
    // =========================

    function allowedExpenseSettingsKeys() {
      return [
        'theme',
        'iconSet',
        'currency',
        'timezone',
        'hideBalance',
        'notificationsEnabled',
        'defaultWalletId',
        'defaultCategoryId',
        'amountFormat',
        'dateFormat',
        'hiddenCategoryIds',
        'hiddenWalletIds',
        'updatedAt',
      ];
    }

    function isValidExpenseTheme(theme) {
      return theme in [
        'sage',
        'fjord',
        'clay',
        'blossom',
        'vintage',
        'retro',
      ];
    }

    function isValidDefaultWalletReference(data, uid) {
      return data.defaultWalletId == null
        || (
          getAfter(
            /databases/$(database)/documents/users/$(uid)/modules/expenses/wallets/$(data.defaultWalletId)
          ).data.isArchived == false
          && getAfter(
            /databases/$(database)/documents/users/$(uid)/modules/expenses/wallets/$(data.defaultWalletId)
          ).data.type != 'saving'
        );
    }

    function isValidExpenseSettings(data, uid) {
      return data.keys().hasOnly(allowedExpenseSettingsKeys())
        && data.keys().hasAll([
          'theme',
          'iconSet',
          'currency',
          'timezone',
          'hideBalance',
          'notificationsEnabled',
          'defaultWalletId',
          'defaultCategoryId',
          'amountFormat',
          'dateFormat',
          'hiddenCategoryIds',
          'hiddenWalletIds',
          'updatedAt',
        ])
        && isValidExpenseTheme(data.theme)
        && data.iconSet in ['emoji', 'base']
        && isValidCurrency(data.currency)
        && isValidString(data.timezone)
        && data.hideBalance is bool
        && data.notificationsEnabled is bool
        && (data.defaultWalletId == null || data.defaultWalletId is string)
        && (data.defaultCategoryId == null || data.defaultCategoryId is string)
        && data.amountFormat in ['standard', 'compact']
        && data.dateFormat in ['dd/MM/yyyy', 'MM/dd/yyyy', 'yyyy-MM-dd']
        && data.hiddenCategoryIds is list
        && data.hiddenWalletIds is list
        && isValidDefaultWalletReference(data, uid)
        && data.updatedAt == request.time;
    }

    function isValidExpenseSettingsCreate(uid) {
      return isValidExpenseSettings(request.resource.data, uid);
    }

    function isValidExpenseSettingsUpdate(uid) {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(allowedExpenseSettingsKeys())
        && isValidExpenseSettings(request.resource.data, uid);
    }

    // =========================
    // Wallets
    // users/{uid}/modules/expenses/wallets/{walletId}
    // =========================

    function allowedWalletKeys() {
      return [
        'name',
        'type',
        'icon',
        'color',
        'balance',
        'initialBalance',
        'creditLimit',
        'outstandingDebt',
        'availableCredit',
        'currency',
        'order',
        'isBalanceInitialized',
        'isArchived',
        'createdAt',
        'updatedAt',
      ];
    }

    // Transitional schema for documents created before defaultWalletId became
    // the single source of truth. Updates may preserve or remove isDefault,
    // but cannot add or change it.
    function allowedLegacyWalletKeys() {
      return [
        'name',
        'type',
        'icon',
        'color',
        'balance',
        'initialBalance',
        'creditLimit',
        'outstandingDebt',
        'availableCredit',
        'currency',
        'order',
        'isDefault',
        'isBalanceInitialized',
        'isArchived',
        'createdAt',
        'updatedAt',
      ];
    }

    function isValidWalletType(type) {
      return type in [
        'cash',
        'bank',
        'eWallet',
        'credit-card',
        'saving',
        'other',
      ];
    }

    function creditCardWalletKeys() {
      return [
        'creditLimit',
        'outstandingDebt',
        'availableCredit',
      ];
    }

    function isValidCreditCardWalletProjection(data) {
      return data.keys().hasAll(creditCardWalletKeys())
        && data.balance == 0
        && data.initialBalance == 0
        && data.creditLimit is number
        && data.creditLimit > 0
        && data.outstandingDebt is number
        && data.outstandingDebt >= 0
        && data.outstandingDebt <= data.creditLimit
        && data.availableCredit is number
        && data.availableCredit == data.creditLimit - data.outstandingDebt;
    }

    function isValidStandardWalletProjection(data) {
      return !data.keys().hasAny(creditCardWalletKeys());
    }

    function isValidWalletProjection(data) {
      return (
          data.type == 'credit-card'
          && isValidCreditCardWalletProjection(data)
        )
        || (
          data.type != 'credit-card'
          && isValidStandardWalletProjection(data)
        );
    }

    function isValidInitialWalletBalanceSetup() {
      return !(
          resource.data.type != 'credit-card'
          && !resource.data.isBalanceInitialized
          && request.resource.data.isBalanceInitialized
        )
        || request.resource.data.initialBalance > 0;
    }

    function isValidWalletCreate(data) {
      return data.keys().hasOnly(allowedWalletKeys())
        && data.keys().hasAll([
          'name',
          'type',
          'icon',
          'color',
          'balance',
          'initialBalance',
          'currency',
          'order',
          'isBalanceInitialized',
          'isArchived',
          'createdAt',
          'updatedAt',
        ])
        && isValidString(data.name)
        && isValidWalletType(data.type)
        && isValidString(data.icon)
        && isValidString(data.color)
        && data.balance is number
        && data.initialBalance is number
        && isValidWalletProjection(data)
        && isValidCurrency(data.currency)
        && data.order is int
        && data.isBalanceInitialized is bool
        && data.isArchived is bool
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function doesNotArchiveDefaultWallet(uid, walletId) {
      return !request.resource.data.isArchived
        || resource.data.isArchived
        || getAfter(
          /databases/$(database)/documents/users/$(uid)/modules/expenses/settings/main
        ).data.defaultWalletId != walletId;
    }

    function isValidWalletUpdate(uid, walletId) {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'name',
            'type',
            'icon',
            'color',
            'balance',
            'initialBalance',
            'creditLimit',
            'outstandingDebt',
            'availableCredit',
            'currency',
            'order',
            'isDefault',
            'isBalanceInitialized',
            'isArchived',
            'updatedAt',
          ])
        && request.resource.data.keys().hasOnly(allowedLegacyWalletKeys())
        && isValidString(request.resource.data.name)
        && isValidWalletType(request.resource.data.type)
        && (
          (resource.data.type == 'saving' && request.resource.data.type == 'saving')
          || (resource.data.type != 'saving' && request.resource.data.type != 'saving')
        )
        && isValidString(request.resource.data.icon)
        && isValidString(request.resource.data.color)
        && request.resource.data.balance is number
        && request.resource.data.initialBalance is number
        && isValidWalletProjection(request.resource.data)
        && isValidCurrency(request.resource.data.currency)
        && request.resource.data.order is int
        && (
          !('isDefault' in request.resource.data)
          || (
            'isDefault' in resource.data
            && request.resource.data.isDefault is bool
            && request.resource.data.isDefault == resource.data.isDefault
          )
        )
        && request.resource.data.isBalanceInitialized is bool
        && request.resource.data.isArchived is bool
        && doesNotArchiveDefaultWallet(uid, walletId)
        && isValidInitialWalletBalanceSetup()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    // =========================
    // Categories
    // users/{uid}/modules/expenses/categories/{categoryId}
    // =========================

    function allowedCategoryKeys() {
      return [
        'name',
        'type',
        'icon',
        'color',
        'sortOrder',
        'isArchived',
        'createdAt',
        'updatedAt',
      ];
    }

    function isValidCategoryType(type) {
      return type in [
        'expense',
        'income',
      ];
    }

    function isValidCategoryCreate(data) {
      return data.keys().hasOnly(allowedCategoryKeys())
        && data.keys().hasAll([
          'name',
          'type',
          'icon',
          'color',
          'sortOrder',
          'isArchived',
          'createdAt',
          'updatedAt',
        ])
        && isValidString(data.name)
        && isValidCategoryType(data.type)
        && isValidString(data.icon)
        && isValidString(data.color)
        && data.sortOrder is int
        && data.isArchived is bool
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidCategoryUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'name',
            'icon',
            'color',
            'sortOrder',
            'isArchived',
            'updatedAt',
          ])
        && request.resource.data.keys().hasOnly(allowedCategoryKeys())
        && isValidString(request.resource.data.name)
        && isValidCategoryType(request.resource.data.type)
        && isValidString(request.resource.data.icon)
        && isValidString(request.resource.data.color)
        && request.resource.data.sortOrder is int
        && request.resource.data.isArchived is bool
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    // =========================
    // Transactions
    // users/{uid}/modules/expenses/transactions/{transactionId}
    // =========================

    function allowedTransactionKeys() {
      return [
        'type',
        'adjustmentDirection',
        'budgetSavingsMonthKey',
        'budgetSavingsCategoryId',
        'savingsTransferKind',
        'amountMinor',
        'currency',
        'title',
        'titleNormalized',
        'searchTokens',
        'note',
        'categoryId',
        'walletId',
        'fromWalletId',
        'toWalletId',
        'walletIds',
        'occurredAt',
        'localDate',
        'monthKey',
        'timezone',
        'categorySnapshot',
        'walletSnapshot',
        'fromWalletSnapshot',
        'toWalletSnapshot',
        'status',
        'createdAt',
        'updatedAt',
        'voidedAt',
      ];
    }

    function requiredTransactionKeys() {
      return [
        'type',
        'amountMinor',
        'currency',
        'title',
        'titleNormalized',
        'searchTokens',
        'note',
        'categoryId',
        'walletId',
        'fromWalletId',
        'toWalletId',
        'walletIds',
        'occurredAt',
        'localDate',
        'monthKey',
        'timezone',
        'categorySnapshot',
        'walletSnapshot',
        'fromWalletSnapshot',
        'toWalletSnapshot',
        'status',
        'createdAt',
        'updatedAt',
        'voidedAt',
      ];
    }

    function isValidTransactionType(type) {
      return type in [
        'expense',
        'income',
        'transfer',
        'creditPayment',
        'adjustment',
      ];
    }

    function isValidSnapshot(snapshot) {
      return snapshot is map
        && snapshot.keys().hasOnly([
          'name',
          'icon',
          'color',
          'type',
        ])
        && isValidString(snapshot.name)
        && isValidString(snapshot.icon)
        && isValidString(snapshot.color)
        && (
          !snapshot.keys().hasAny(['type'])
          || isValidString(snapshot.type)
        );
    }

    function isValidSearchTokens(tokens) {
      return tokens is list
        && tokens.size() <= 500
        && (
          tokens.size() == 0
          || tokens[0] is string
        );
    }

    function isValidBudgetSavingsMetadata(data) {
      let hasMetadata = data.keys().hasAny([
        'budgetSavingsMonthKey',
        'budgetSavingsCategoryId',
      ]);

      return !hasMetadata
        || (
          data.type == 'transfer'
          && data.keys().hasAll([
            'budgetSavingsMonthKey',
            'budgetSavingsCategoryId',
          ])
          && isValidString(data.budgetSavingsMonthKey)
          && isValidString(data.budgetSavingsCategoryId)
          && data.savingsTransferKind == 'deposit'
          && data.fromWalletSnapshot.type != 'credit-card'
          && data.fromWalletSnapshot.type != 'saving'
          && data.toWalletSnapshot.type == 'saving'
        );
    }

    function isValidSavingsTransferMetadata(data) {
      let hasKind = data.keys().hasAny(['savingsTransferKind']);

      return data.type != 'transfer'
        ? !hasKind
        : (
          (
            !hasKind
            && data.fromWalletSnapshot.type != 'saving'
            && data.toWalletSnapshot.type != 'saving'
          )
          || (
            hasKind
            && data.savingsTransferKind in ['deposit', 'withdrawal']
            && (
              (
                data.savingsTransferKind == 'deposit'
                && data.fromWalletSnapshot.type != 'credit-card'
                && data.fromWalletSnapshot.type != 'saving'
                && data.toWalletSnapshot.type == 'saving'
              )
              || (
                data.savingsTransferKind == 'withdrawal'
                && data.fromWalletSnapshot.type == 'saving'
                && data.toWalletSnapshot.type != 'credit-card'
                && data.toWalletSnapshot.type != 'saving'
              )
            )
          )
        );
    }

    function isValidExpenseOrIncomeTransaction(data) {
      return data.type in [
          'expense',
          'income',
        ]
        && isValidString(data.categoryId)
        && isValidString(data.walletId)
        && data.fromWalletId == null
        && data.toWalletId == null
        && data.walletIds is list
        && data.walletIds.size() == 1
        && data.walletIds[0] == data.walletId
        && isValidSnapshot(data.categorySnapshot)
        && isValidSnapshot(data.walletSnapshot)
        && (
          data.walletSnapshot.type != 'saving'
          || (data.type == 'income' && data.categoryId == 'interest')
        )
        && data.fromWalletSnapshot == null
        && data.toWalletSnapshot == null
        && !data.keys().hasAny(['adjustmentDirection']);
    }

    function isValidTransferTransaction(data) {
      return data.type == 'transfer'
        && data.categoryId == null
        && data.walletId == null
        && isValidString(data.fromWalletId)
        && isValidString(data.toWalletId)
        && data.fromWalletId != data.toWalletId
        && data.walletIds is list
        && data.walletIds.size() == 2
        && data.walletIds[0] == data.fromWalletId
        && data.walletIds[1] == data.toWalletId
        && data.categorySnapshot == null
        && data.walletSnapshot == null
        && isValidSnapshot(data.fromWalletSnapshot)
        && isValidSnapshot(data.toWalletSnapshot)
        && !data.keys().hasAny(['adjustmentDirection']);
    }

    function isValidCreditPaymentTransaction(data) {
      return data.type == 'creditPayment'
        && data.categoryId == null
        && data.walletId == null
        && isValidString(data.fromWalletId)
        && isValidString(data.toWalletId)
        && data.fromWalletId != data.toWalletId
        && data.walletIds is list
        && data.walletIds.size() == 2
        && data.walletIds[0] == data.fromWalletId
        && data.walletIds[1] == data.toWalletId
        && data.categorySnapshot == null
        && data.walletSnapshot == null
        && isValidSnapshot(data.fromWalletSnapshot)
        && isValidSnapshot(data.toWalletSnapshot)
        && data.fromWalletSnapshot.type != 'credit-card'
        && data.fromWalletSnapshot.type != 'saving'
        && data.toWalletSnapshot.type == 'credit-card'
        && !data.keys().hasAny(['adjustmentDirection']);
    }

    function isValidAdjustmentTransaction(data) {
      return data.type == 'adjustment'
        && data.adjustmentDirection in [
          'increase',
          'decrease',
        ]
        && data.categoryId == null
        && isValidString(data.walletId)
        && data.fromWalletId == null
        && data.toWalletId == null
        && data.walletIds is list
        && data.walletIds.size() == 1
        && data.walletIds[0] == data.walletId
        && data.categorySnapshot == null
        && isValidSnapshot(data.walletSnapshot)
        && data.walletSnapshot.type != 'saving'
        && data.fromWalletSnapshot == null
        && data.toWalletSnapshot == null;
    }

    function isValidTransactionCreate(data) {
      return data.keys().hasOnly(allowedTransactionKeys())
        && data.keys().hasAll(requiredTransactionKeys())
        && isValidTransactionType(data.type)
        && data.amountMinor is int
        && data.amountMinor > 0
        && isValidCurrency(data.currency)
        && isValidString(data.title)
        && isValidString(data.titleNormalized)
        && isValidSearchTokens(data.searchTokens)
        && data.note is string
        && data.occurredAt is timestamp
        && isValidString(data.localDate)
        && isValidString(data.monthKey)
        && isValidString(data.timezone)
        && data.status == 'active'
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.voidedAt == null
        && isValidBudgetSavingsMetadata(data)
        && isValidSavingsTransferMetadata(data)
        && (
          isValidExpenseOrIncomeTransaction(data)
          || isValidTransferTransaction(data)
          || isValidCreditPaymentTransaction(data)
          || isValidAdjustmentTransaction(data)
        );
    }

    function isValidTransactionUpdate() {
      return resource.data.status == 'active'
        && resource.data.voidedAt == null
        && request.resource.data.keys().hasOnly(allowedTransactionKeys())
        && request.resource.data.keys().hasAll(requiredTransactionKeys())
        && isValidTransactionType(request.resource.data.type)
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor > 0
        && isValidCurrency(request.resource.data.currency)
        && isValidString(request.resource.data.title)
        && isValidString(request.resource.data.titleNormalized)
        && isValidSearchTokens(request.resource.data.searchTokens)
        && request.resource.data.note is string
        && request.resource.data.occurredAt is timestamp
        && isValidString(request.resource.data.localDate)
        && isValidString(request.resource.data.monthKey)
        && isValidString(request.resource.data.timezone)
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.voidedAt == null
        && isValidSavingsTransferMetadata(resource.data)
        && isValidBudgetSavingsMetadata(request.resource.data)
        && isValidSavingsTransferMetadata(request.resource.data)
        && (
          !resource.data.keys().hasAny([
            'budgetSavingsMonthKey',
            'budgetSavingsCategoryId',
            'savingsTransferKind',
          ])
          && !request.resource.data.keys().hasAny([
            'budgetSavingsMonthKey',
            'budgetSavingsCategoryId',
            'savingsTransferKind',
          ])
        )
        && (
          isValidExpenseOrIncomeTransaction(request.resource.data)
          || isValidTransferTransaction(request.resource.data)
          || isValidCreditPaymentTransaction(request.resource.data)
          || isValidAdjustmentTransaction(request.resource.data)
        );
    }

    function isValidTransactionVoid() {
      return resource.data.status == 'active'
        && resource.data.voidedAt == null
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status',
              'updatedAt',
              'voidedAt',
            ])
        && request.resource.data.status == 'voided'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.voidedAt == request.time;
    }

    // =========================
    // Budgets
    // users/{uid}/modules/expenses/budgets/{budgetId}
    // =========================

    function allowedBudgetKeys() {
      return [
        'monthKey',
        'categoryId',
        'limitMinor',
        'alertThreshold',
        'createdAt',
        'updatedAt',
      ];
    }

    function isActiveExpenseCategory(uid, categoryId) {
      return exists(/databases/$(database)/documents/users/$(uid)/modules/expenses/categories/$(categoryId))
        && get(/databases/$(database)/documents/users/$(uid)/modules/expenses/categories/$(categoryId)).data.type == 'expense'
        && get(/databases/$(database)/documents/users/$(uid)/modules/expenses/categories/$(categoryId)).data.isArchived == false;
    }

    function isValidBudgetData(data, uid) {
      return data.keys().hasOnly(allowedBudgetKeys())
        && data.keys().hasAll(allowedBudgetKeys())
        && isValidString(data.monthKey)
        && isValidString(data.categoryId)
        && isActiveExpenseCategory(uid, data.categoryId)
        && data.limitMinor is int
        && data.limitMinor > 0
        && data.alertThreshold is int
        && data.alertThreshold >= 1
        && data.alertThreshold <= 100;
    }

    function isValidBudgetCreate(data, uid) {
      return isValidBudgetData(data, uid)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidBudgetUpdate(uid) {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'limitMinor',
            'alertThreshold',
            'updatedAt',
          ])
        && isValidBudgetData(request.resource.data, uid)
        && request.resource.data.monthKey == resource.data.monthKey
        && request.resource.data.categoryId == resource.data.categoryId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    // =========================
    // Monthly stats
    // users/{uid}/modules/expenses/monthlyStats/{monthKey}
    // =========================

    function allowedMonthlyStatsKeys() {
      return [
        'monthKey',
        'incomeMinor',
        'expenseMinor',
        'netMinor',
        'transactionCount',
        'categoryExpenseMinor',
        'categoryIncomeMinor',
        'updatedAt',
      ];
    }

    function isValidMonthlyStats(data, monthKey) {
      return data.keys().hasOnly(allowedMonthlyStatsKeys())
        && data.keys().hasAll(allowedMonthlyStatsKeys())
        && data.monthKey == monthKey
        && data.incomeMinor is number
        && data.incomeMinor >= 0
        && data.expenseMinor is number
        && data.expenseMinor >= 0
        && data.netMinor is number
        && data.netMinor == data.incomeMinor - data.expenseMinor
        && data.transactionCount is int
        && data.transactionCount >= 0
        && data.categoryExpenseMinor is map
        && data.categoryIncomeMinor is map
        && data.updatedAt == request.time;
    }

    // =========================
    // Quote favorites
    // users/{uid}/modules/quotes/favorites/{quoteId}
    // =========================

    function isKnownQuoteId(quoteId) {
      return quoteId in [
        'life-quiet-road',
        'life-small-choice',
        'life-carry-light',
        'healing-rest',
        'healing-cracks',
        'healing-gentle',
        'ancient-dream',
        'ancient-cloud',
        'ancient-moon',
        'peace-presence',
        'peace-tea',
        'peace-window',
        'family-light',
        'family-table',
        'family-return',
        'work-depth',
        'work-seed',
        'work-pause',
        'motivation-step',
        'motivation-mountain',
        'motivation-begin',
        'lonely-room',
        'lonely-moon',
        'lonely-listen',
        'ancient-parting-rain',
        'ancient-life-drama',
        'life-own-pace',
        'life-open-window',
        'life-enough',
        'life-seasons',
        'life-light-luggage',
        'life-kindness-return',
        'life-present-day',
        'life-river-bend',
        'healing-breathe',
        'healing-scar',
        'healing-slow-morning',
        'healing-self-forgive',
        'healing-rain-pass',
        'healing-soft-heart',
        'healing-new-leaf',
        'healing-safe-place',
        'ancient-wandering-sword',
        'ancient-river-moon',
        'ancient-old-letter',
        'ancient-autumn-wind',
        'ancient-distant-flute',
        'ancient-dust-road',
        'ancient-silent-pavilion',
        'ancient-spring-dream',
        'ancient-one-thought',
        'ancient-pity-mistaken-love',
        'ancient-unwritten-beloved',
        'peace-early-sun',
        'peace-rain-roof',
        'peace-empty-calendar',
        'peace-slow-breath',
        'peace-garden',
        'peace-no-answer',
        'peace-evening-lamp',
        'peace-still-water',
        'family-door',
        'family-call',
        'family-kitchen',
        'family-old-hands',
        'family-waiting',
        'family-childhood',
        'family-shared-rice',
        'family-home-sound',
        'work-focus',
        'work-craft',
        'work-mistake',
        'work-patience',
        'work-finish',
        'work-courage-no',
        'work-quiet-progress',
        'work-rested-mind',
        'motivation-one-more',
        'motivation-after-fall',
        'motivation-small-fire',
        'motivation-own-race',
        'motivation-hard-day',
        'motivation-door',
        'motivation-try-again',
        'motivation-horizon',
        'lonely-own-company',
        'lonely-night-light',
        'lonely-empty-seat',
        'lonely-silence',
        'lonely-stars',
        'lonely-walk-home',
        'lonely-name-feeling',
        'lonely-dawn',
        'lonely-tired-wings',
        'healing-past-person',
      ];
    }

    function isValidQuoteFavorite(data, quoteId) {
      return data.keys().hasOnly([
          'quoteId',
          'createdAt',
        ])
        && data.keys().hasAll([
          'quoteId',
          'createdAt',
        ])
        && data.quoteId is string
        && data.quoteId.size() > 0
        && data.quoteId.size() <= 80
        && data.quoteId.matches('^[a-z0-9-]+$')
        && data.quoteId == quoteId
        && isKnownQuoteId(quoteId)
        && data.createdAt == request.time;
    }

    // =========================
    // Rules
    // =========================

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidUserProfileCreate(request.resource.data);
      allow update: if isOwner(uid)
        && isValidUserProfileUpdate();
      allow delete: if false;

      match /modules/expenses {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && isValidExpenseModuleCreate(request.resource.data);

        allow update: if isOwner(uid)
          && isValidExpenseModuleUpdate();

        allow delete: if false;

        match /settings/main {
          allow read: if isOwner(uid);

          allow create: if isOwner(uid)
            && isValidExpenseSettingsCreate(uid);

          allow update: if isOwner(uid)
            && isValidExpenseSettingsUpdate(uid);

          allow delete: if false;
        }

        match /wallets/{walletId} {
          allow read: if isOwner(uid);

          allow create: if isOwner(uid)
            && isValidWalletCreate(request.resource.data);

          allow update: if isOwner(uid)
            && isValidWalletUpdate(uid, walletId);

          allow delete: if false;
        }

        match /categories/{categoryId} {
          allow read: if isOwner(uid);

          allow create: if isOwner(uid)
            && isValidCategoryCreate(request.resource.data);

          allow update: if isOwner(uid)
            && isValidCategoryUpdate();

          allow delete: if false;
        }

        match /transactions/{transactionId} {
          allow read: if isOwner(uid);

          allow create: if isOwner(uid)
            && isValidTransactionCreate(request.resource.data);

          allow update: if isOwner(uid)
            && (
              isValidTransactionUpdate()
              || isValidTransactionVoid()
            );

          allow delete: if false;
        }

        match /budgets/{budgetId} {
          allow read: if isOwner(uid);

          allow create: if isOwner(uid)
            && isValidBudgetCreate(request.resource.data, uid);

          allow update: if isOwner(uid)
            && isValidBudgetUpdate(uid);

          allow delete: if isOwner(uid);
        }

        match /monthlyStats/{monthKey} {
          allow read: if isOwner(uid);

          allow create, update: if isOwner(uid)
            && isValidMonthlyStats(request.resource.data, monthKey);

          allow delete: if false;
        }
      }

      match /modules/quotes {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;

        match /favorites/{quoteId} {
          allow read: if isOwner(uid);

          allow create: if isOwner(uid)
            && isValidQuoteFavorite(request.resource.data, quoteId);

          allow update: if false;
          allow delete: if isOwner(uid);
        }
      }

      match /{document=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
