rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function allowedExpenseSettingsKeys() {
      return [
        'theme',
        'currency',
        'timezone',
        'hideBalance',
        'notificationsEnabled',
        'defaultWalletId',
        'updatedAt',
      ];
    }

    function isValidExpenseTheme(theme) {
      return theme in ['sage', 'fjord', 'clay', 'blossom', 'vintage', 'retro'];
    }

    function isValidExpenseCurrency(currency) {
      return currency in ['VND', 'USD'];
    }

    function isValidExpenseSettings(data) {
      return data.keys().hasOnly(allowedExpenseSettingsKeys())
        && data.keys().hasAll([
          'theme',
          'currency',
          'timezone',
          'hideBalance',
          'notificationsEnabled',
          'defaultWalletId',
          'updatedAt',
        ])
        && isValidExpenseTheme(data.theme)
        && isValidExpenseCurrency(data.currency)
        && data.timezone is string
        && data.timezone.size() > 0
        && data.hideBalance is bool
        && data.notificationsEnabled is bool
        && (data.defaultWalletId == null || data.defaultWalletId is string)
        && data.updatedAt == request.time;
    }

    function isValidExpenseSettingsCreate() {
      return isValidExpenseSettings(request.resource.data);
    }

    function isValidExpenseSettingsUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(allowedExpenseSettingsKeys())
        && isValidExpenseSettings(request.resource.data);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /settings/expenses {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidExpenseSettingsCreate();
        allow update: if isOwner(uid) && isValidExpenseSettingsUpdate();
        allow delete: if false;
      }

      match /{document=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
