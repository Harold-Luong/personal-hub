rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // =========================
    // Common
    // =========================

    function isValidCurrency(currency) {
      return currency in ['VND', 'USD'];
    }

    function isValidString(value) {
      return value is string && value.size() > 0;
    }

    function isOptionalString(value) {
      return value == null || value is string;
    }

    // =========================
    // User profile
    // users/{uid}
    // =========================

    function allowedUserProfileKeys() {
      return [
        'displayName',
        'email',
        'photoURL',
        'createdAt',
        'initializedAt',
        'updatedAt',
      ];
    }

    function isValidUserProfileCreate(data) {
      return data.keys().hasOnly(allowedUserProfileKeys())
        && data.keys().hasAll([
          'displayName',
          'email',
          'photoURL',
          'createdAt',
          'initializedAt',
          'updatedAt',
        ])
        && isOptionalString(data.displayName)
        && isOptionalString(data.email)
        && isOptionalString(data.photoURL)
        && data.createdAt == request.time
        && data.initializedAt == request.time
        && data.updatedAt == request.time;
    }

    // =========================
    // Expense module root
    // users/{uid}/modules/expenses
    // =========================

    function allowedExpenseModuleKeys() {
      return [
        'enabled',
        'createdAt',
        'updatedAt',
      ];
    }

    function isValidExpenseModuleCreate(data) {
      return data.keys().hasOnly(allowedExpenseModuleKeys())
        && data.keys().hasAll([
          'enabled',
          'createdAt',
          'updatedAt',
        ])
        && data.enabled is bool
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidExpenseModuleUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'enabled',
            'updatedAt',
          ])
        && request.resource.data.enabled is bool
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    // =========================
    // Expense settings
    // users/{uid}/modules/expenses/settings/main
    // =========================

    function allowedExpenseSettingsKeys() {
      return [
        'theme',
        'currency',
        'timezone',
        'hideBalance',
        'notificationsEnabled',
        'defaultWalletId',
        'updatedAt',
      ];
    }

    function isValidExpenseTheme(theme) {
      return theme in [
        'sage',
        'fjord',
        'clay',
        'blossom',
        'vintage',
        'retro',
      ];
    }

    function isValidExpenseSettings(data) {
      return data.keys().hasOnly(allowedExpenseSettingsKeys())
        && data.keys().hasAll([
          'theme',
          'currency',
          'timezone',
          'hideBalance',
          'notificationsEnabled',
          'defaultWalletId',
          'updatedAt',
        ])
        && isValidExpenseTheme(data.theme)
        && isValidCurrency(data.currency)
        && isValidString(data.timezone)
        && data.hideBalance is bool
        && data.notificationsEnabled is bool
        && (data.defaultWalletId == null || data.defaultWalletId is string)
        && data.updatedAt == request.time;
    }

    function isValidExpenseSettingsCreate() {
      return isValidExpenseSettings(request.resource.data);
    }

    function isValidExpenseSettingsUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(allowedExpenseSettingsKeys())
        && isValidExpenseSettings(request.resource.data);
    }

    // =========================
    // Wallets
    // users/{uid}/modules/expenses/wallets/{walletId}
    // =========================

    function allowedWalletKeys() {
      return [
        'name',
        'type',
        'icon',
        'color',
        'balance',
        'initialBalance',
        'currency',
        'order',
        'isDefault',
        'isArchived',
        'createdAt',
        'updatedAt',
      ];
    }

    function isValidWalletType(type) {
      return type in [
        'cash',
        'bank',
        'eWallet',
        'card',
        'saving',
        'other',
      ];
    }

    function isValidWalletCreate(data) {
      return data.keys().hasOnly(allowedWalletKeys())
        && data.keys().hasAll([
          'name',
          'type',
          'icon',
          'color',
          'balance',
          'initialBalance',
          'currency',
          'order',
          'isDefault',
          'isArchived',
          'createdAt',
          'updatedAt',
        ])
        && isValidString(data.name)
        && isValidWalletType(data.type)
        && isValidString(data.icon)
        && isValidString(data.color)
        && data.balance is number
        && data.initialBalance is number
        && isValidCurrency(data.currency)
        && data.order is int
        && data.isDefault is bool
        && data.isArchived is bool
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidWalletUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'name',
            'type',
            'icon',
            'color',
            'balance',
            'initialBalance',
            'currency',
            'order',
            'isDefault',
            'isArchived',
            'updatedAt',
          ])
        && request.resource.data.keys().hasOnly(allowedWalletKeys())
        && isValidString(request.resource.data.name)
        && isValidWalletType(request.resource.data.type)
        && isValidString(request.resource.data.icon)
        && isValidString(request.resource.data.color)
        && request.resource.data.balance is number
        && request.resource.data.initialBalance is number
        && isValidCurrency(request.resource.data.currency)
        && request.resource.data.order is int
        && request.resource.data.isDefault is bool
        && request.resource.data.isArchived is bool
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    // =========================
    // Categories
    // users/{uid}/modules/expenses/categories/{categoryId}
    // =========================

    function allowedCategoryKeys() {
      return [
        'name',
        'type',
        'icon',
        'color',
        'sortOrder',
        'isArchived',
        'createdAt',
        'updatedAt',
      ];
    }

    function isValidCategoryType(type) {
      return type in [
        'expense',
        'income',
      ];
    }

    function isValidCategoryCreate(data) {
      return data.keys().hasOnly(allowedCategoryKeys())
        && data.keys().hasAll([
          'name',
          'type',
          'icon',
          'color',
          'sortOrder',
          'isArchived',
          'createdAt',
          'updatedAt',
        ])
        && isValidString(data.name)
        && isValidCategoryType(data.type)
        && isValidString(data.icon)
        && isValidString(data.color)
        && data.sortOrder is int
        && data.isArchived is bool
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidCategoryUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'name',
            'icon',
            'color',
            'sortOrder',
            'isArchived',
            'updatedAt',
          ])
        && request.resource.data.keys().hasOnly(allowedCategoryKeys())
        && isValidString(request.resource.data.name)
        && isValidCategoryType(request.resource.data.type)
        && isValidString(request.resource.data.icon)
        && isValidString(request.resource.data.color)
        && request.resource.data.sortOrder is int
        && request.resource.data.isArchived is bool
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    // =========================
    // Rules
    // =========================

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidUserProfileCreate(request.resource.data);
      allow update, delete: if false;

      match /modules/expenses {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && isValidExpenseModuleCreate(request.resource.data);

        allow update: if isOwner(uid)
          && isValidExpenseModuleUpdate();

        allow delete: if false;

        match /settings/main {
          allow read: if isOwner(uid);

          allow create: if isOwner(uid)
            && isValidExpenseSettingsCreate();

          allow update: if isOwner(uid)
            && isValidExpenseSettingsUpdate();

          allow delete: if false;
        }

        match /wallets/{walletId} {
          allow read: if isOwner(uid);

          allow create: if isOwner(uid)
            && isValidWalletCreate(request.resource.data);

          allow update: if isOwner(uid)
            && isValidWalletUpdate();

          allow delete: if false;
        }

        match /categories/{categoryId} {
          allow read: if isOwner(uid);

          allow create: if isOwner(uid)
            && isValidCategoryCreate(request.resource.data);

          allow update: if isOwner(uid)
            && isValidCategoryUpdate();

          allow delete: if false;
        }
      }

      match /{document=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
